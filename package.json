{
  "name": "places-to-visit",
  "version": "1.0.0",
  "private": true,
  "description": "Static HTML/CSS/JS site for travel ideas",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "live-server --host=localhost --port=3000 --open=./index.html --ignore=backend/**",
    "dev:all": "node scripts/dev-all.js",
    "preview": "http-server . -o",
    "dev:vercel": "vercel dev",
    "build": "node scripts/write-runtime-config.js",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "live-server": "^1.2.0",
    "rimraf": "^5.0.10"
  },
  "dependencies": {
    "@vercel/kv": "^1.0.1",
    "express": "^4.21.2",
    "html2pdf.js": "^0.14.0",
    "nodemailer": "^7.0.12"
  }
}
